# File MẪU. File .env thật được tạo bằng: cp .env.example .env
# .env thật chứa giá trị riêng của từng môi trường và KHÔNG được đưa lên repo (đã có trong .gitignore).

APP_NAME="Hoc Phi API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database ---
# Chạy bằng Docker Compose: DB_HOST=db (tên service database trong db/docker-compose.yml)
# Chạy PHP trực tiếp trên máy:  DB_HOST=127.0.0.1
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=hoc_phi
DB_USERNAME=hoc_phi_user
DB_PASSWORD=hoc_phi_pass_dev

# --- Frontend được phép gọi API (CORS). Nhiều địa chỉ: ngăn cách bằng dấu phẩy ---
FRONTEND_URL=http://localhost:8080,http://127.0.0.1:8080

# --- Mail ---
# log: không gửi thật, chỉ ghi nội dung email vào storage/logs/laravel.log (dùng cho máy học)
# Môi trường thật đổi sang smtp và điền MAIL_HOST, MAIL_USERNAME, MAIL_PASSWORD
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Các thiết lập khác ---
BCRYPT_ROUNDS=12
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
