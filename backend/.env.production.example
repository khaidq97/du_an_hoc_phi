# MẪU cấu hình cho môi trường PRODUCTION (hệ thống thật, người dùng thật).
# Toàn bộ giá trị trong file này là GIẢ. File .env thật trên máy chủ Production thường do KHÁCH HÀNG
# hoặc DevOps nắm giữ (tùy hợp đồng). BrSE không tự sửa, không xin mật khẩu qua chat.
#
# So với máy học (.env.example), những dòng KHÁC nhau có chú thích "KHÁC LOCAL".

APP_NAME="Hoc Phi API"
# KHÁC LOCAL: nhãn trên giao diện hiện PRODUCTION
APP_ENV=production
# Khóa riêng của Production, giữ bí mật tuyệt đối
APP_KEY=
# KHÁC LOCAL, BẮT BUỘC: không bao giờ bật debug trên bản thật
APP_DEBUG=false
# KHÁC LOCAL: địa chỉ backend thật
APP_URL=https://api.hocphi.example.com
APP_TIMEZONE=Asia/Ho_Chi_Minh

LOG_CHANNEL=stack
LOG_STACK=single
# KHÁC LOCAL: chỉ ghi cảnh báo và lỗi
LOG_LEVEL=warning

# Database Production: dữ liệu thật của người dùng. Sao lưu định kỳ.
# Giá trị dưới đây là VÍ DỤ cho máy chủ thật. Khi thử trên máy học bằng chuyen-moi-truong.sh,
# script giữ nguyên kết nối database Docker của máy bạn.
DB_CONNECTION=mysql
# KHÁC LOCAL (ở Production thật): máy chủ database riêng
DB_HOST=db
DB_PORT=3306
# KHÁC LOCAL (ở Production thật): database riêng
DB_DATABASE=hoc_phi_production
DB_USERNAME=hoc_phi_user
# KHÁC LOCAL (ở Production thật): mật khẩu mạnh, riêng, không ai khác biết
DB_PASSWORD=hoc_phi_pass_dev

FRONTEND_URL=https://hocphi.example.com

# Email thật: gửi tới học viên thật. Kiểm tra kỹ ở Staging trước khi bật ở đây.
# KHÁC LOCAL
MAIL_MAILER=smtp
# KHÁC LOCAL: máy chủ mail thật
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# Giá trị thật chỉ nằm trên máy chủ
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
