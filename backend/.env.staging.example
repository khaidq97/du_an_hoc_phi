# MẪU cấu hình cho môi trường STAGING (bản sao của Production để khách kiểm thử, UAT).
# Toàn bộ giá trị trong file này là GIẢ. Tạo file .env thật trên máy chủ Staging, điền giá trị thật
# do Team lead hoặc DevOps cấp. Không đưa .env thật lên repo, không gửi mật khẩu qua chat.
#
# So với máy học (.env.example), những dòng KHÁC nhau có chú thích "KHÁC LOCAL".

APP_NAME="Hoc Phi API (Staging)"
# KHÁC LOCAL: nhãn trên giao diện hiện STAGING
APP_ENV=staging
# Sinh khóa riêng cho môi trường này (php artisan key:generate)
APP_KEY=
# KHÁC LOCAL: tắt trang lỗi chi tiết, tránh lộ cấu hình
APP_DEBUG=false
# KHÁC LOCAL: địa chỉ backend của Staging
APP_URL=https://api-staging.hocphi.example.com
APP_TIMEZONE=Asia/Ho_Chi_Minh

LOG_CHANNEL=stack
LOG_STACK=single
# KHÁC LOCAL: bớt log chi tiết
LOG_LEVEL=info

# Database riêng của Staging. Dữ liệu là bản sao Production ĐÃ CHE thông tin nhạy cảm (email, điện thoại).
# Giá trị dưới đây là VÍ DỤ cho máy chủ thật. Khi thử trên máy học bằng chuyen-moi-truong.sh,
# script giữ nguyên kết nối database Docker của máy bạn (mọi môi trường dùng chung một database).
DB_CONNECTION=mysql
# KHÁC LOCAL (ở Staging thật): máy chủ database riêng
DB_HOST=db
DB_PORT=3306
# KHÁC LOCAL (ở Staging thật): tên database riêng
DB_DATABASE=hoc_phi_staging
DB_USERNAME=hoc_phi_user
# KHÁC LOCAL (ở Staging thật): mật khẩu mạnh, riêng, do Team lead cấp
DB_PASSWORD=hoc_phi_pass_dev

# Địa chỉ web của frontend Staging được phép gọi API (CORS)
FRONTEND_URL=https://staging.hocphi.example.com

# Email: Staging KHÔNG ĐƯỢC gửi email thật tới học viên thật.
# Dùng hộp thư giả (sandbox): email vào hộp thư giả để kiểm tra, không ra ngoài.
# KHÁC LOCAL: gửi qua máy chủ mail (sandbox)
MAIL_MAILER=smtp
# KHÁC LOCAL: máy chủ hộp thư GIẢ
MAIL_HOST=sandbox.smtp.example.com
MAIL_PORT=2525
# Điền giá trị thật ở máy chủ, không điền vào file mẫu
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
