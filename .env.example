# File MẪU cho Docker Compose (db/docker-compose.yml). File .env thật: cp .env.example .env
# .env thật KHÔNG đưa lên repo. Nếu không tạo .env, Compose dùng giá trị mặc định cho máy học.
#
# CHÚ Ý: backend có file cấu hình riêng là backend/.env (xem backend/.env.example).
# Tên database, user, mật khẩu ở HAI file này phải khớp nhau, nếu không backend không đăng nhập được vào MySQL.
DB_DATABASE=hoc_phi
DB_USERNAME=hoc_phi_user
DB_PASSWORD=hoc_phi_pass_dev
DB_ROOT_PASSWORD=root_pass_dev

# Cổng trên máy bạn (đổi nếu bị trùng cổng với phần mềm khác)
DB_PORT_HOST=3306
ADMINER_PORT_HOST=8081
